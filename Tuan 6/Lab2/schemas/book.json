{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book",
  "type": "object",
  "required": ["title", "price_vnd", "category_id"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "isbn": {
      "type": "string",
      "pattern": "^\\d{13}$"
    },
    "price_vnd": {
      "type": "integer",
      "minimum": 0
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "category_id": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}