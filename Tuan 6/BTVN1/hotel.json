{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.hotelbooking.example/schemas/hotel.json",
  "title": "Hotel",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "starRating", "address"],
  "properties": {
    "id": {"type": "string", "pattern": "^htl_[a-z0-9]+$", "readOnly": true},
    "name": {"type": "string", "minLength": 1, "maxLength": 150},
    "description": {"type": "string", "maxLength": 2000},
    "starRating": {"type": "integer", "minimum": 1, "maximum": 5},
    "address": {"$ref": "#/$defs/address"},
    "priceFrom": {"$ref": "#/$defs/money", "readOnly": true},
    "amenities": {"type": "array", "items": {"$ref": "#/$defs/hotelAmenity"}},
    "createdAt": {"type": "string", "format": "date-time", "readOnly": true}
  },
  "$defs": {
    "address": {
      "type": "object",
      "required": ["street", "city", "country"],
      "properties": {
        "street": {"type": "string", "minLength": 1},
        "city": {"type": "string", "minLength": 1},
        "country": {"type": "string", "pattern": "^[A-Z]{2}$"}
      }
    },
    "hotelAmenity": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^amn_[a-z0-9]+$"},
        "name": {"type": "string"},
        "isFree": {"type": "boolean"}
      }
    },
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "additionalProperties": false,
      "properties": {"amount": {"type": "integer", "minimum": 0}, "currency": {"enum": ["VND", "USD", "EUR"]}}
    }
  }
}
